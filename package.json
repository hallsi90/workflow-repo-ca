{
  "name": "workflow-repo",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "lint-staged": {
    "**/*.html": [
      "prettier --write"
    ],
    "**/*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "scripts": {
    "dev": "npx tailwindcss -c ./tailwind.config.cjs -i ./css/input.css -o ./css/style.css --watch",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.12",
    "vitest": "^4.0.16"
  }
}
